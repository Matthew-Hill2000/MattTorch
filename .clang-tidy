Checks: >
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  modernize-*,
  cppcoreguidelines-*,
  readability-*,
  -modernize-use-trailing-return-type,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access, 
  -modernize-use-nodiscard,
  -readability-identifier-length

HeaderFilterRegex: '.*/MattTorch/(include|src|examples|tests)/.*'
ExcludeHeaderFilterRegex: '.*/(_deps|build|debugBuild|releaseBuild)/.*'

WarningsAsErrors: ''
