</parameternamelist>
<parameterdescription>
<para>The input tensor to apply <ref refid="classmattTorch_1_1Softmax" kindref="compound">Softmax</ref> activation to </para>
</parameterdescription>
</parameteritem>
</parameterlist>
<simplesect kind="return"><para>A <ref refid="classmattTorch_1_1TensorView" kindref="compound">TensorView</ref> containing the normalised probability output </para>
</simplesect>
</para>
        </detaileddescription>
